DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=pickupland.ir,www.pickupland.ir
DJANGO_CSRF_TRUSTED_ORIGINS=https://pickupland.ir,https://www.pickupland.ir
DJANGO_SECURE_SSL_REDIRECT=1
SITE_URL=https://pickupland.ir
PICKUP_THEME=clean_room

# در Docker این مسیر خودکار است؛ برای اجرای محلی می‌توانید خالی بگذارید
# SQLITE_PATH=/app/data/db.sqlite3

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@pickupland.ir
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=پیک آپ لند <no-reply@pickupland.ir>
CONTACT_NOTIFY_EMAIL=info@pickupland.ir
